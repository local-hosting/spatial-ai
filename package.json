{
  "name": "@local-hosting/spatial-ai",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "private": true,
  "description": "Local spatial AI: place-grounded layer on @local-hosting/local-ai (geokit/geotypes linked, not merged).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-hosting/spatial-ai.git"
  },
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "yarn build:ui && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist ui/dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "yarn typecheck",
    "test": "vitest run",
    "pretest": "yarn workspace @local-hosting/compose build && yarn workspace @local-hosting/vocab build && yarn build:ui",
    "prestart": "node scripts/ensure-ui-dist.mjs",
    "ci": "yarn test",
    "test:watch": "vitest",
    "start": "node --import tsx src/api/start-server.ts",
    "start:boot": "sh runtime/boot.sh"
  },
  "dependencies": {
    "@local-hosting/compose": "0.1.0",
    "@local-hosting/geokit": "0.4.4",
    "@local-hosting/geotypes": "0.2.0",
    "@local-hosting/local-ai": "0.1.0",
    "@local-hosting/vocab": "0.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.13.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
