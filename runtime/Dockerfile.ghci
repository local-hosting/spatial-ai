# syntax=docker/dockerfile:1.6
# CI: stack is built on the runner (workspace checkout + bootstrap:stack). This file only assembles the image.
# See .github/workflows/build-image.yml and runtime/build-stack.sh for local builds.

FROM node:26-bookworm-slim AS node-sidecar
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN npm install -g corepack \
  && corepack enable \
  && corepack prepare yarn@4.18.1 --activate

FROM ghcr.io/ggml-org/llama.cpp:server

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node-sidecar /usr/local/bin/node /usr/local/bin/node

WORKDIR /app/ws

COPY package.json yarn.lock .yarnrc.yml ./
COPY node_modules ./node_modules
COPY comms ./comms
COPY frames ./frames
COPY compose ./compose
COPY vocab ./vocab
COPY local-ai ./local-ai
COPY spatial-ai ./spatial-ai

ENV LOCAL_AI_RUNTIME_ROOT=/app/ws/local-ai
ENV LOCAL_AI_BIND_HOST=0.0.0.0
ENV SPATIAL_AI_BIND_HOST=0.0.0.0
ENV LOCAL_AI_LLAMA_PORT=11435
ENV LOCAL_AI_BOOT_MODE=full
ENV PORT=11434
ENV LOCAL_AI_GGUF_PATH=/models/model.gguf
ENV LOCAL_AI_MODEL_ALIAS=qwen2.5-7b
ENV LOCAL_AI_CTX_SIZE=8192
ENV LOCAL_AI_N_PARALLEL=1
ENV LOCAL_AI_WEIGHTS_MODE=mmap
ENV SPATIAL_AI_START_GLINER=0

WORKDIR /app/ws/spatial-ai
EXPOSE 11434

HEALTHCHECK --interval=30s --timeout=10s --start-period=1200s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" >/dev/null || exit 1

CMD ["/bin/sh", "/app/ws/spatial-ai/runtime/boot.sh"]